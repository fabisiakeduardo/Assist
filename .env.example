# ─── Nexo Assist ─────────────────────────────────────────────────────────────
# Copie para apps/api/.env (ou exporte no ambiente antes de rodar a API).

# Motor do agent:
#   "mastra"   → usa LLM de verdade via Mastra (precisa de chave do provedor)
#   "scripted" → agent determinístico, sem chave, bom para demo offline e testes
#   (padrão)   → "mastra" se houver chave configurada, senão "scripted"
AGENT_ENGINE=auto

# Provedor/modelo do LLM usado pelo motor Mastra.
# Qualquer provider suportado pelo roteador de modelos do Mastra funciona
# (google/..., openai/..., anthropic/..., xai/...). A chave correspondente
# precisa estar no ambiente.
# Default: google/gemini-2.5-flash — grátis no AI Studio (aistudio.google.com).
LLM_MODEL=google/gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=          # p/ LLM_MODEL=xai/grok-4-fast-reasoning etc.

# Temperatura do modelo (raciocínio do service desk é melhor determinístico).
LLM_TEMPERATURE=0.2

# Porta da API.
PORT=4100

# Arquivo SQLite (criado e semeado automaticamente na primeira execução).
DATABASE_FILE=./data/nexo.db

# Instabilidade do serviço de chamados legado: probabilidade (0–1) de uma
# chamada falhar/atrasar por alguns segundos. 0 desliga o "caos".
TICKETS_CHAOS_RATE=0.12

# Limite de mensagens do funcionário por dia (regra do produto).
DAILY_MESSAGE_LIMIT=30

# Login: "true" (padrão) aceita qualquer senha — exigência do desafio.
# "false" valida a senha real (scrypt). Senha demo semeada: nexo123.
AUTH_ANY_PASSWORD=true

# Busca da central de ajuda: "hybrid" (embeddings locais + lexical, padrão),
# "vector" (só similaridade de embeddings) ou "lexical" (modo legado).
HELP_SEARCH_MODE=hybrid

# Job de escalonamento por SLA: conversas aguardando analista sobem para N2
# quando o chamado vinculado vence o prazo ou a espera passa do limite.
ESCALATION_INTERVAL_SEC=30   # intervalo do job (segundos)
ESCALATION_WAIT_MINUTES=60   # espera máxima em waiting_analyst (minutos)

# ── SSO corporativo (OIDC) ───────────────────────────────────────────────────
# Com OIDC_ISSUER + OIDC_CLIENT_ID configurados, a tela de login mostra um
# botão "Entrar com SSO". Fluxo Authorization Code + PKCE, id_token validado
# via JWKS (RS/ES 256–512) — sem dependência externa.
# Em dev, aponte OIDC_REDIRECT_URI para o Vite (a proxy repassa /api).
# OIDC_ISSUER=https://login.seu-idp.com
# OIDC_CLIENT_ID=nexo-assist
# OIDC_CLIENT_SECRET=            # opcional (client público usa só PKCE)
# OIDC_REDIRECT_URI=http://localhost:5100/api/auth/oidc/callback
# OIDC_SCOPES="openid email profile"
# OIDC_LABEL="Entrar com SSO corporativo"

# O front (Vite) já faz proxy de /api → http://localhost:4100 em dev.
# Só ajuste se a API rodar em outra porta/host — veja apps/web/vite.config.ts.
