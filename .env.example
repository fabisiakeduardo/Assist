# ─── Nexo Assist ─────────────────────────────────────────────────────────────
# Copie para apps/api/.env (ou exporte no ambiente antes de rodar a API).

# Motor do agent:
#   "mastra"   → usa LLM de verdade via Mastra (precisa de chave do provedor)
#   "scripted" → agent determinístico, sem chave, bom para demo offline e testes
#   (padrão)   → "mastra" se houver chave configurada, senão "scripted"
AGENT_ENGINE=auto

# Provedor/modelo do LLM usado pelo motor Mastra.
# Qualquer provider suportado pelo roteador de modelos do Mastra funciona
# (openai/..., anthropic/..., google/...). A chave correspondente precisa
# estar no ambiente (OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY...).
LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Temperatura do modelo (raciocínio do service desk é melhor determinístico).
LLM_TEMPERATURE=0.2

# Porta da API.
PORT=4100

# Arquivo SQLite (criado e semeado automaticamente na primeira execução).
DATABASE_FILE=./data/nexo.db

# Instabilidade do serviço de chamados legado: probabilidade (0–1) de uma
# chamada falhar/atrasar por alguns segundos. 0 desliga o "caos".
TICKETS_CHAOS_RATE=0.12

# Limite de mensagens do funcionário por dia (regra do produto).
DAILY_MESSAGE_LIMIT=30

# O front (Vite) já faz proxy de /api → http://localhost:4100 em dev.
# Só ajuste se a API rodar em outra porta/host — veja apps/web/vite.config.ts.
